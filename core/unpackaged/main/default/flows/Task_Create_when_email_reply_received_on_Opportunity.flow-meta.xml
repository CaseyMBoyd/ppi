    <description>Cleaned up links in email body.</description>
    <environments>Default</environments>
    <formulas>
        <name>BodyForTask</name>
        <dataType>String</dataType>
        <expression>LEFT(
  IF(
    NOT(ISBLANK({!$Record.TextBody})),
    {!$Record.TextBody},
    /* Clean up common HTML constructs -&gt; line breaks and spaces */
    SUBSTITUTE(
      SUBSTITUTE(
        SUBSTITUTE(
          SUBSTITUTE(
            SUBSTITUTE(
              SUBSTITUTE(
                SUBSTITUTE(
                  SUBSTITUTE(
                    SUBSTITUTE(
                      SUBSTITUTE(
                        SUBSTITUTE(
                          SUBSTITUTE(
                            SUBSTITUTE(
                              SUBSTITUTE(
                                SUBSTITUTE(
                                  SUBSTITUTE(
                                    SUBSTITUTE(
                                      SUBSTITUTE(
                                        SUBSTITUTE(
                                          SUBSTITUTE(
                                            SUBSTITUTE(
                                              SUBSTITUTE(
                                                SUBSTITUTE(
                                                  SUBSTITUTE(
                                                    SUBSTITUTE(
                                                      SUBSTITUTE(
                                                        SUBSTITUTE(
                                                          SUBSTITUTE(
                                                            SUBSTITUTE(
                                                              SUBSTITUTE(
                                                                SUBSTITUTE({!$Record.HtmlBody}, &quot;&lt;br/&gt;&quot;, &quot;\n&quot;),
                                                              &quot;&lt;br&gt;&quot;, &quot;\n&quot;),
                                                            &quot;&lt;br /&gt;&quot;, &quot;\n&quot;),
                                                          &quot;&lt;/p&gt;&quot;, &quot;\n\n&quot;),
                                                        &quot;&lt;p&gt;&quot;, &quot;&quot;),
                                                      &quot;&lt;/div&gt;&quot;, &quot;\n&quot;),
                                                    &quot;&lt;div&gt;&quot;, &quot;&quot;),
                                                  &quot;&lt;/li&gt;&quot;, &quot;\n&quot;),
                                                &quot;&lt;li&gt;&quot;, &quot; • &quot;),
                                              &quot;&lt;/ul&gt;&quot;, &quot;\n&quot;),
                                            &quot;&lt;ol&gt;&quot;, &quot;\n&quot;),
                                          &quot;&lt;/ol&gt;&quot;, &quot;\n&quot;),
                                        &quot;&lt;hr&gt;&quot;, &quot;\n----------------\n&quot;),
                                      &quot;&amp;nbsp;&quot;, &quot; &quot;),
                                    &quot;&amp;amp;&quot;, &quot;&amp;&quot;),
                                  &quot;&amp;lt;&quot;, &quot;&lt;&quot;),
                                &quot;&amp;gt;&quot;, &quot;&gt;&quot;),
                              &quot;&lt;strong&gt;&quot;, &quot;&quot;),
                            &quot;&lt;/strong&gt;&quot;, &quot;&quot;),
                          &quot;&lt;em&gt;&quot;, &quot;&quot;),
                        &quot;&lt;/em&gt;&quot;, &quot;&quot;),
                      &quot;&lt;b&gt;&quot;, &quot;&quot;),
                    &quot;&lt;/b&gt;&quot;, &quot;&quot;),
                  &quot;&lt;i&gt;&quot;, &quot;&quot;),
                &quot;&lt;/i&gt;&quot;, &quot;&quot;),
              &quot;&lt;u&gt;&quot;, &quot;&quot;),
            &quot;&lt;/u&gt;&quot;, &quot;&quot;),
          &quot;&lt;span&gt;&quot;, &quot;&quot;),
        &quot;&lt;/span&gt;&quot;, &quot;&quot;),
      &quot;&lt;!--&quot;, &quot;&quot;),  /* crude removal start */
    &quot;--&gt;&quot;, &quot;&quot;)       /* crude removal end */
  ),
  32000
)</expression>
    </formulas>
    <formulas>
        <name>BodyPlain</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    IF(
      NOT(ISBLANK({!$Record.TextBody})),
      /* TextBody: strip link schemes, trackers, angle brackets */
      SUBSTITUTE(
        SUBSTITUTE(
          SUBSTITUTE(
            SUBSTITUTE(
              SUBSTITUTE(
                SUBSTITUTE(
                  SUBSTITUTE(
                    SUBSTITUTE(
                      {!$Record.TextBody},
                      &quot;http://&quot;, &quot;&quot;
                    ),
                    &quot;https://&quot;, &quot;&quot;
                  ),
                  &quot;mailto:&quot;, &quot;&quot;
                ),
                &quot;tel:&quot;, &quot;&quot;
              ),
              &quot;cid:image&quot;, &quot;&quot;
            ),
            &quot;us.content.exclaimer.net&quot;, &quot;&quot;
          ),
          &quot;&lt;&quot;, &quot;&quot;
        ),
        &quot;&gt;&quot;, &quot;&quot;
      ),
      /* HtmlBody: convert breaks -&gt; newlines, then same scrubs */
      SUBSTITUTE(
        SUBSTITUTE(
          SUBSTITUTE(
            SUBSTITUTE(
              SUBSTITUTE(
                SUBSTITUTE(
                  SUBSTITUTE(
                    SUBSTITUTE(
                      SUBSTITUTE(
                        SUBSTITUTE(
                          SUBSTITUTE(
                            {!$Record.HtmlBody},
                            &quot;&lt;br /&gt;&quot;, &quot;\n&quot;
                          ),
                          &quot;&lt;br&gt;&quot;, &quot;\n&quot;
                        ),
                        &quot;&lt;/p&gt;&quot;, &quot;\n\n&quot;
                      ),
                      &quot;&lt;p&gt;&quot;, &quot;&quot;
                    ),
                    &quot;&lt;/div&gt;&quot;, &quot;\n&quot;
                  ),
                  &quot;&lt;div&gt;&quot;, &quot;&quot;
                ),
                &quot;&amp;nbsp;&quot;, &quot; &quot;
              ),
              &quot;http://&quot;, &quot;&quot;
            ),
            &quot;https://&quot;, &quot;&quot;
          ),
          &quot;mailto:&quot;, &quot;&quot;
        ),
        &quot;tel:&quot;, &quot;&quot;
      )
      /* After initial clean, strip remaining patterns &amp; brackets */
    ),
    &quot;  &quot;, &quot; &quot;
  ),
  &quot;  &quot;, &quot; &quot;
)</expression>
    </formulas>
    <formulas>
        <name>ReplyFirstNLines</name>
        <dataType>String</dataType>
        <expression>LEFT(
  {!BodyPlain},
  CASE(
    /* Count newlines, capped at N (N = 6 here) */
    MIN(
      6,
      LEN({!BodyPlain}) - LEN(SUBSTITUTE({!BodyPlain}, &quot;\n&quot;, &quot;&quot;))
    ),
    0, LEN({!BodyPlain}),
    1, FIND(&quot;\n&quot;, {!BodyPlain}),
    2, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}) + 1),
    3, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}) + 1) + 1),
    4, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}) + 1) + 1) + 1),
    5, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}) + 1) + 1) + 1) + 1),
    6, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}, FIND(&quot;\n&quot;, {!BodyPlain}) + 1) + 1) + 1) + 1) + 1),
    LEN({!BodyPlain})
  ) - 1
)</expression>
    </formulas>
    <formulas>
        <name>subjectDoesNotContain</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!$Record.Subject}, &apos;Ticket Resolved&apos;))</expression>
    </formulas>
