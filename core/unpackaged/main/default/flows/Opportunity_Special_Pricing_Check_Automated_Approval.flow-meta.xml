        </connector>
    </assignments>
    <decisions>
        <name>Is_Auto_Approved</name>
        <label>Is Auto Approved?</label>
        <locationX>248</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Assign_Special_Pricing_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1 AND ((2 AND 3) OR (4 AND 5)) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>IsAutoApprovedWithoutOppType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pulley</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PulleyFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Idler</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IdlerFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.Special_Pricing_Notes__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Auto_Approved</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Salesman_Email_Exists</name>
        <label>Salesman Email Exists</label>
        <locationX>446</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Email Doesn&apos;t Exist</defaultConnectorLabel>
        <rules>
            <name>Email_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.Account.Salesman_Email__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Auto_Approve_Denial_Email</targetReference>
            </connector>
            <label>Email Exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DiscountPercentageToRawDecimal</name>
        <dataType>Number</dataType>
        <expression>IF(ISPICKVAL({!OpportunityRecord.Discount_Percentage__c}, &quot;None&quot;), 0, VALUE(LEFT(TEXT({!OpportunityRecord.Discount_Percentage__c}), LEN(TEXT({!OpportunityRecord.Discount_Percentage__c})) - 1))/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Request for Special Pricing on Quote #&quot; + {!OpportunityRecord.Quote_Number__c}</expression>
    </formulas>
    <formulas>
        <name>IdlerFormula</name>
        <dataType>Boolean</dataType>
        <expression>({!OpportunityRecord.Account.Idler_Multiplier__c} - ({!OpportunityRecord.Account.Idler_Multiplier__c}*{!DiscountPercentageToRawDecimal}))&gt;= 0.283</expression>
    </formulas>
    <formulas>
        <name>IsAutoApprovedWithoutOppType</name>
        <dataType>Boolean</dataType>
        <expression>AND({!OpportunityRecord.Indirect_Customer__r.Name}=&quot;None&quot;, NOT({!OpportunityRecord.Complex_Pricing__c}), NOT({!OpportunityRecord.Freight_Agreement__c}))</expression>
    </formulas>
    <formulas>
        <name>PulleyFormula</name>
        <dataType>Boolean</dataType>
        <expression>(IF(ISBLANK({!OpportunityRecord.Account.PulleyMultiplier__c}),0,VALUE({!OpportunityRecord.Account.PulleyMultiplier__c})) - IF(ISBLANK({!OpportunityRecord.Account.PulleyMultiplier__c}),0,VALUE({!OpportunityRecord.Account.PulleyMultiplier__c})*{!DiscountPercentageToRawDecimal}))&gt;= 0.300</expression>
    </formulas>
    <interviewLabel>Opportunity - Special Pricing - Check Automated Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Special Pricing - Check Automated Approval</label>
