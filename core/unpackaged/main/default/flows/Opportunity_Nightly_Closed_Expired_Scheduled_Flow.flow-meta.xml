    <decisions>
        <name>Check_Days_and_Territory</name>
        <label>Check Days and Territory</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Valid_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LastActivityDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>todayMinus90days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Territory.territory__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>39.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Territory.territory__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>47.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Closed_Expired</targetReference>
            </connector>
            <label>Is Valid Expired</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>todayMinus90days</name>
        <dataType>Date</dataType>
        <expression>(TODAY() - 90)</expression>
    </formulas>
