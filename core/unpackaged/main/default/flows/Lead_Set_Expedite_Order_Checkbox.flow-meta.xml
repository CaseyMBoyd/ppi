<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>No_Expedite_Flag</name>
        <label>No Expedite Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Expedite_Order__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Expedite_Flag</name>
        <label>Set Expedite Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Expedite_Order__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Contains_Expedite_Keyword</name>
        <label>Contains Expedite Keyword</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Expedite_Flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Expedite</defaultConnectorLabel>
        <rules>
            <name>Yes_Expedite</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasExpediteKeyword</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Expedite_Flag</targetReference>
            </connector>
            <label>Yes Expedite</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>HasExpediteKeyword</name>
        <dataType>Boolean</dataType>
        <expression>REGEX(
  LOWER( BLANKVALUE({!$Record.Customer_Request_Subject__c}, &quot;&quot;) ),
  &quot;.*\\b(rush|hot|expedite|expedited|expediting|urgent|asap|priority|break\\s?down|breakdown|as soon as possible|quick turnaround|next\\s?day|next-day|nextday)\\b.*&quot;
)</expression>
    </formulas>
    <interviewLabel>Lead - Set Expedite Order Checkbox {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Set Expedite Order Checkbox</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Contains_Expedite_Keyword</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
