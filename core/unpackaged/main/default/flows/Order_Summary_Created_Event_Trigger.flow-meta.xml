    <decisions>
        <name>Did_Integration_User_Create_Order</name>
        <label>Did Integration User Create Order?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Get_Order_Confirmation_Template</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Order was not Created by Integration</defaultConnectorLabel>
        <rules>
            <name>Order_was_Created_by_Integration</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderSummary.CreatedBy.Username</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Commerce_Settings.Integration_Username__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>createdDateDifference</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <label>Order was Created by Integration</label>
        </rules>
    </decisions>
    <description>Trigger to send Order Confirmation Email Template after Order Summary is successfully created</description>
    <environments>Default</environments>
    <formulas>
        <name>createdDateDifference</name>
        <dataType>Number</dataType>
        <expression>(DATETIMEVALUE({!$Record.OrderSummary.CreatedDate}) - DATETIMEVALUE({!$Record.Order.CreatedDate}))*24</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Order Summary Created Event Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Summary Created Event Trigger</label>
