    <description>New version based on Lead queue as a picklist instead of a member of the SF Queue Object.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_TargetLeadQueue</name>
        <dataType>String</dataType>
        <expression>CASE(
  {!Get_Related_Account.territory__c},
  35, &quot;West 35&quot;,
  26, &quot;West 26&quot;,
  15, &quot;West 15&quot;,
   3, &quot;Central 3&quot;,
   9, &quot;Central 9&quot;,
  16, &quot;Central 16&quot;,
  14, &quot;Central 14&quot;,
  24, &quot;Central 24&quot;,
   4, &quot;East 4&quot;,
  21, &quot;East 21&quot;,
  11, &quot;East 11&quot;,
  33, &quot;East 33&quot;,
  NULL
)</expression>
    </formulas>
