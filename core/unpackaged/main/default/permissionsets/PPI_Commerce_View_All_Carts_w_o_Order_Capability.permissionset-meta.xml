<?xml version="1.0" encoding="utf-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Ability to see all carts made while not having permission to take cart(s) to order</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>PPI Commerce - View All Carts w/o Order Capability</label>
    <customPermissions>
        <enabled>true</enabled>
        <name>Cannot_Checkout</name>
    </customPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>B2BCommerceSuperUser</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>B2BCommerceUser</name>
    </userPermissions>
</PermissionSet>
